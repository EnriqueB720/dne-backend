generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId         Int      @id @default(autoincrement()) @map("user_id")
  email          String   @unique @db.VarChar(100)
  password       String
  name           String   @unique @db.VarChar(100)
  phone          String   @unique
  language       Language @default(SPANISH)
  country        String
  role           Role     @default(SUPPLIER)
  profilePicture String?
  createdAt      DateTime @default(now()) @map("created_at")

  supplier     Supplier[]
  subscription Subscription[]

  @@map("user")
}

model Subscription {
  subscriptionId Int         @id @default(autoincrement()) @map("subscription_id")
  userId         Int         @map("user_id")
  user           User        @relation(fields: [userId], references: [userId])
  planId         Int         @map("plan_id")
  plan           PricingPlan @relation(fields: [planId], references: [planId])
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  status         String

  @@map("subscription")
}

model PricingPlan {
  planId   Int     @id @default(autoincrement()) @map("plan_id")
  planName String
  price    Decimal
  features String

  subscription Subscription[]

  @@map("pricing_plan")
}

model Supplier {
  supplierId  Int    @id @default(autoincrement()) @map("supplier_id")
  userId      Int    @unique @map("user_id")
  user        User   @relation(fields: [userId], references: [userId])
  companyName String
  posts       Post[]

  @@map("supplier")
}

model Post {
  postId      Int      @id @default(autoincrement()) @map("post_id")
  supplierId  Int      @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [supplierId])
  categoryId  Int      @map("category_id")
  category    Category @relation(fields: [categoryId], references: [categoryId])
  title       String
  description String
  media_url   String
  price       Decimal
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("post")
}

model Category {
  categoryId   Int    @id @default(autoincrement()) @map("category_id")
  categoryName String

  posts Post[]

  @@map("category")
}

model Conversation {
  conversationId String    @id @default(uuid()) @map("conversation_id")
  deviceId       String    @map("device_id") @db.VarChar(128)
  title          String    @db.VarChar(255)
  model          String    @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@index([deviceId])
  @@map("conversation")
}

model Message {
  messageId      String       @id @default(uuid()) @map("message_id")
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
  role           String       @db.VarChar(16)
  content        String       @db.Text
  model          String?      @db.VarChar(64)
  inputTokens    Int?         @map("input_tokens")
  outputTokens   Int?         @map("output_tokens")
  providersJson  String?      @map("providers_json") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("message")
}

enum Language {
  SPANISH
  ENGLISH
}

enum Role {
  ADMIN
  SUPPLIER
}
