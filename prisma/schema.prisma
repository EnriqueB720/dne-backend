generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// Solvo MVP schema — customers find suppliers through the AI chat and
// contact them directly. See docs/ARCHITECTURE.md for the full picture
// and docs/DATABASE.md for what each table is for.
//
// Conventions
//  - Every column is snake_case in Postgres (`@map`), camelCase in code.
//  - A fact lives in ONE column. Yes/no facts that also need a date are
//    stored as a nullable timestamp only (`verifiedAt`, `preferredAt`,
//    `claimedAt`): set = yes, null = no.
//  - Locations use ISO 3166-2 subdivision codes (`CR-SJ`, `CR-H`, …) so a
//    second country only needs entries in src/shared/geo, not a migration.
// =====================================================================

// ── Identity ─────────────────────────────────────────────────────────

model User {
  userId         Int       @id @default(autoincrement()) @map("user_id")
  email          String    @unique @db.VarChar(100)
  /// Null for accounts created through Google/GitHub sign-in.
  password       String?
  /// Display name. Not unique — login is by email.
  name           String    @db.VarChar(100)
  /// Null until a social-login user finishes onboarding.
  phone          String?   @unique
  language       Language  @default(SPANISH)
  /// ISO 3166-1 alpha-2 country code.
  country        String    @default("CR") @db.VarChar(2)
  profilePicture String?   @map("profile_picture")

  /// Account type. A user is a customer OR a supplier; admin is a separate
  /// permission flag (an admin may also be either). New social-login users
  /// have both false until they finish onboarding.
  isCustomer Boolean @default(false) @map("is_customer")
  isSupplier Boolean @default(false) @map("is_supplier")
  isAdmin    Boolean @default(false) @map("is_admin")

  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  supplier            Supplier?
  customer            Customer?
  aiConversations     AiConversation[]
  oauthAccounts       OAuthAccount[]
  aiUsageLogs         AiUsageLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("user")
}

/// Links a user to a Google/GitHub identity. Looked up by (provider, providerId).
model OAuthAccount {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  provider   String   @db.VarChar(32)
  providerId String   @map("provider_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_account")
}

/// Single-use, 1-hour tokens for the "forgot password" flow.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  token     String    @unique @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

/// Profile row for signed-in customers. Holds no data of its own yet — it
/// is the anchor for the reviews they write and the contacts they make.
/// Guests never get one (their contacts are keyed by device id).
model Customer {
  customerId Int      @id @default(autoincrement()) @map("customer_id")
  userId     Int      @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [userId])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reviewsWritten Review[]       @relation("CustomerReviews")
  contactEvents  ContactEvent[]

  @@map("customer")
}

// ── Suppliers ────────────────────────────────────────────────────────

model Supplier {
  supplierId  Int    @id @default(autoincrement()) @map("supplier_id")
  userId      Int    @unique @map("user_id")
  user        User   @relation(fields: [userId], references: [userId])
  companyName String @map("company_name")

  tagline     String?
  description String?
  /// Short lowercase capabilities ("fugas de agua", "wedding dj") that
  /// sharpen AI matching beyond categories. Drafted by the AI while empty.
  skills      String[] @default([])

  /// pgvector embedding of name + tagline + description + skills + services
  /// + categories (OpenAI text-embedding-3-small). Written via raw SQL.
  descriptionEmbedding Unsupported("vector(1536)")? @map("description_embedding")

  businessPhone    String? @map("business_phone")
  businessPhoneAlt String? @map("business_phone_alt")
  businessEmail    String? @map("business_email")
  businessEmailAlt String? @map("business_email_alt")
  whatsappNumber   String? @map("whatsapp_number")
  websiteUrl       String? @map("website_url")

  /// Where the business is based — ISO 3166-2 code, e.g. "CR-H" (Heredia).
  province         String?  @db.VarChar(10)
  /// Every province the supplier serves. Always contains `province`.
  /// This is what the chat search filters on.
  serviceProvinces String[] @default([]) @map("service_provinces")
  /// Canton / town shown on the profile ("Escazú"). Free text.
  city             String?
  address          String?
  lat              Decimal? @db.Decimal(10, 7)
  lng              Decimal? @db.Decimal(10, 7)

  /// Cache of AVG/COUNT over visible reviews, maintained by ReviewService
  /// so search can rank without aggregating on every query.
  rating      Decimal? @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")

  /// Set by an admin after checking the business. Null = not verified.
  verifiedAt     DateTime? @map("verified_at")
  /// Set by an admin to pin the supplier to the top of search results.
  preferredAt    DateTime? @map("preferred_at")
  /// Optional end of the preferred placement. Null = no end date.
  preferredUntil DateTime? @map("preferred_until")

  /// How the row got here. Scraped rows are owned by a shell user until a
  /// real person claims them (`claimedAt` set).
  source    SupplierSource @default(SELF_SIGNUP)
  claimedAt DateTime?      @map("claimed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  services        Service[]
  categories      SupplierCategory[]
  reviewsReceived Review[]           @relation("SupplierReviews")
  contactEvents   ContactEvent[]
  scrapeSources   ScrapeSource[]

  @@index([province])
  @@index([serviceProvinces], type: Gin)
  @@index([rating])
  @@index([createdAt])
  @@map("supplier")
}

/// What a supplier does at the broadest level. Bilingual; `slug` is the
/// stable key used by seeds and the scraper.
model Category {
  categoryId   Int      @id @default(autoincrement()) @map("category_id")
  slug         String   @unique
  nameEs       String   @map("name_es")
  nameEn       String   @map("name_en")
  /// Single emoji shown on chips.
  icon         String?
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  supplierCategories SupplierCategory[]

  @@map("category")
}

model SupplierCategory {
  supplierId Int      @map("supplier_id")
  categoryId Int      @map("category_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  supplier   Supplier @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [categoryId])
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_category")
}

/// A service or product the supplier lists on their profile, with an
/// optional starting price ("Fuga de agua — desde ₡15,000 por visita").
model Service {
  serviceId   Int      @id @default(autoincrement()) @map("service_id")
  supplierId  Int      @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)
  name        String
  description String?
  priceFrom   Decimal? @map("price_from") @db.Decimal(12, 2)
  /// Free text after the price: "hora", "m²", "unidad". Null = flat price.
  priceUnit   String?  @map("price_unit")
  currency    String   @default("CRC") @db.VarChar(3)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@map("service")
}

/// Raw import payload for suppliers created by dne-scraper (Google Places).
model ScrapeSource {
  scrapeSourceId Int            @id @default(autoincrement()) @map("scrape_source_id")
  supplierId     Int            @map("supplier_id")
  supplier       Supplier       @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)
  source         SupplierSource
  externalId     String         @map("external_id")
  sourceUrl      String?        @map("source_url")
  rawData        Json           @map("raw_data")
  firstScrapedAt DateTime       @default(now()) @map("first_scraped_at")
  lastScrapedAt  DateTime       @default(now()) @map("last_scraped_at")

  @@unique([source, externalId])
  @@index([supplierId])
  @@map("scrape_source")
}

// ── Customer ↔ supplier ──────────────────────────────────────────────

/// One review per customer per supplier (edit to change it).
model Review {
  reviewId   Int      @id @default(autoincrement()) @map("review_id")
  customerId Int      @map("customer_id")
  customer   Customer @relation("CustomerReviews", fields: [customerId], references: [customerId])
  supplierId Int      @map("supplier_id")
  supplier   Supplier @relation("SupplierReviews", fields: [supplierId], references: [supplierId], onDelete: Cascade)
  /// 1–5 stars.
  rating     Int
  text       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([customerId, supplierId])
  @@index([supplierId, createdAt])
  @@map("review")
}

/// Someone reaching out to a supplier: the chat "Contact" button or a click
/// on a phone / email / WhatsApp / website link. This is the
/// customer↔supplier interaction Solvo measures, the signed-in customer's
/// "saved interactions" list, and what the "How did it go?" review prompt
/// follows up on. Repeat clicks within 24h collapse into one row.
model ContactEvent {
  contactEventId Int            @id @default(autoincrement()) @map("contact_event_id")
  supplierId     Int            @map("supplier_id")
  supplier       Supplier       @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)
  /// Null for guests.
  customerId     Int?           @map("customer_id")
  customer       Customer?      @relation(fields: [customerId], references: [customerId])
  /// Guest dedupe key (the chat's `solvo:device-id`). Null when customerId is set.
  deviceId       String?        @map("device_id")
  channel        ContactChannel
  /// Where the click happened: 'chat' or 'profile'.
  source         String?
  /// "Not now" on the review prompt for this contact.
  reviewPromptDismissedAt DateTime? @map("review_prompt_dismissed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([supplierId, createdAt])
  @@index([customerId, supplierId])
  @@index([createdAt])
  @@map("contact_event")
}

// ── AI chat ──────────────────────────────────────────────────────────

/// A chat thread. Owned by `userId` when signed in, otherwise by `deviceId`.
model AiConversation {
  conversationId String   @id @default(uuid()) @map("conversation_id")
  deviceId       String   @map("device_id") @db.VarChar(128)
  userId         Int?     @map("user_id")
  user           User?    @relation(fields: [userId], references: [userId])
  title          String   @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages AiMessage[]

  @@index([deviceId])
  @@index([userId, updatedAt])
  @@map("ai_conversation")
}

model AiMessage {
  messageId      String         @id @default(uuid()) @map("message_id")
  conversationId String         @map("conversation_id")
  conversation   AiConversation @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
  /// 'user' | 'assistant'
  role           String         @db.VarChar(16)
  content        String         @db.Text
  /// Which model actually answered (assistant rows only).
  model          String?        @db.VarChar(64)
  /// Supplier cards shown under this reply, as JSON, so reloads keep them.
  providersJson  String?        @map("providers_json") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("ai_message")
}

/// One row per model call (token counts + estimated cost). Ops data.
model AiUsageLog {
  aiUsageLogId Int      @id @default(autoincrement()) @map("ai_usage_log_id")
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [userId])
  modelName    String   @map("model_name")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([modelName, createdAt])
  @@index([createdAt])
  @@map("ai_usage_log")
}

// ── Enums ────────────────────────────────────────────────────────────

enum Language {
  SPANISH
  ENGLISH
}

enum SupplierSource {
  SELF_SIGNUP
  GOOGLE_PLACES
  MANUAL_IMPORT
}

enum ContactChannel {
  CHAT_CONTACT
  PHONE
  EMAIL
  WHATSAPP
  WEBSITE
}
