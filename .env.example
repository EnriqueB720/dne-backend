# Copy to .env.local for development. On Railway set these as service variables.
NODE_ENV=local
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dne"
JWT_SECRET=change-me

# Google OAuth client (also used for Drive uploads of supplier photos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# AI — chat always tries Claude first, Gemini only as fallback.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Embeddings for semantic supplier search (keyword search still works without it)
OPENAI_API_KEY=
# SUPPLIER_SEMANTIC_MAX_DISTANCE=0.65

# Email (password reset) — production only
# RESEND_API_KEY=
# FRONTEND_BASE_URL=https://solvocr.com

# "How did it go?" review prompt delay after a contact (hours)
# REVIEW_PROMPT_DELAY_HOURS=48
